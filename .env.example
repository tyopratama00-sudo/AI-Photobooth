HOST=127.0.0.1
PORT=4173
# gemini | openai | puter
# gemini: key dari https://aistudio.google.com/apikey
# openai: AI_ENDPOINT=https://api.openai.com/v1, AI_MODEL=<model image>
# puter: tanpa key; login akun Puter di browser, AI_MODEL=gemini-3.1-flash-image
AI_PROVIDER=gemini
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-nano-banana-2.1
AI_API_KEY=replace_with_new_key
MAX_UPLOAD_MB=15
